{
  "compilerOptions": {
    "module": "commonjs",
    "target": "es2018",
    "lib": [ "DOM", "DOM.Iterable", "es2017" ],
    "composite": true,
    "sourceMap": false,
    "strict": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "skipLibCheck": true,
    "rootDir": ".",
    "outDir": "../build/webview"
  },
  "include": [
    "**/*.ts"
  ]
}
